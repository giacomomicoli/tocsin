<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Tocsin third-party licenses</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 56rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
    pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; font-size: 0.85rem; }
    li { margin-bottom: 0.25rem; }
  </style>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p>Tocsin is built on these open-source Rust crates. Their licenses are listed below.</p>

  <h2>Overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>

  <h2>License texts</h2>
  {{#each licenses}}
  <h3 id="{{id}}">{{name}}</h3>
  <p>Used by:</p>
  <ul>
    {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
    {{/each}}
  </ul>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
